# Shopify Headless Ecommerce Configuration (Server-Side Only)
# Enter your permanent myshopify.com domain from Shopify Admin -> Settings -> Domains
SHOPIFY_DOMAIN=your-store.myshopify.com

# Storefront Access Token (used server-side by /api/shopify/* endpoints)
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token

# Shopify Storefront API Version
SHOPIFY_API_VERSION=2024-10

# Private Storefront Access Token (kept strictly on server side - never expose or prefix with VITE_)
# SHOPIFY_PRIVATE_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
