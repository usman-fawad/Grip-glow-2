# Shopify Headless Ecommerce Configuration
# Enter your permanent myshopify.com domain from Shopify Admin -> Settings -> Domains
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com

# Public Storefront Access Token (safe for client-side queries)
VITE_SHOPIFY_STOREFRONT_TOKEN=16ccefd5c4a7e518daf939f2888d0ea2

# Shopify Storefront API Version
VITE_SHOPIFY_API_VERSION=2024-10

